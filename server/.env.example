PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database configuration (PostgreSQL)
DATABASE_URL="postgresql://username:password@localhost:5432/subscriptly_db"

# Authentication
JWT_SECRET="replace_with_a_secure_cryptographic_random_secret_in_production"
JWT_EXPIRES_IN="7d"

# Email / SMTP configuration (Optional: falling back to safe local console preview)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=password
EMAIL_FROM="Subscriptly <no-reply@subscriptly.io>"
