# ==========================================
# Subscriptly — Environment Configuration
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# PostgreSQL Database (Cluster port 5433 or default 5432)
DATABASE_URL="postgresql://postgres@127.0.0.1:5433/subscriptly_dev"

# Authentication & JWT Security
JWT_SECRET="subscriptly_jwt_super_secret_phase1_key_development_only_change_in_prod"
JWT_EXPIRES_IN="7d"

# SMTP Delivery (Optional for Ethereal preview in dev)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Subscriptly <no-reply@subscriptly.io>"

# Supabase Auth Configuration
# Client: Use VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY (Public / Anon Key)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-publishable-key-here"

# Backend: Optional for administrative credential synchronization (Server-side ONLY)
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your-anon-publishable-key-here"
SUPABASE_SERVICE_ROLE_KEY=""

