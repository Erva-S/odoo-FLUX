# ==========================================
# Subscriptly — Environment Configuration
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# PostgreSQL Database (Cluster port 5433 or default 5432)
DATABASE_URL="postgresql://postgres@127.0.0.1:5433/subscriptly_dev"

# Authentication & JWT Security
JWT_SECRET="subscriptly_jwt_super_secret_phase1_key_development_only_change_in_prod"
JWT_EXPIRES_IN="7d"

# SMTP Delivery (Optional for Ethereal preview in dev)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Subscriptly <no-reply@subscriptly.io>"

